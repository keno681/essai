extends SceneTree
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var subclass=GDScript.new()
	subclass.source_code='extends "res://atelier.gd"\nvar launches := 0\nfunc launch_game() -> void:\n\tlaunches += 1\n'
	assert(subclass.reload()==OK)
	var tool=subclass.new()
	root.add_child(tool)
	tool.game_root="/tmp/atelier-restart-"+str(Time.get_ticks_usec())
	DirAccess.make_dir_recursive_absolute(tool.game_root)
	var file=FileAccess.open(tool.game_root+"/project.godot",FileAccess.WRITE)
	file.store_string('config_version=5\n[application]\nconfig/name="Restart fixture"\nrun/main_scene="res://main.tscn"\n')
	file.close()
	file=FileAccess.open(tool.game_root+"/main.gd",FileAccess.WRITE)
	file.store_string('extends Node\nfunc _ready() -> void:\n\tvar f=FileAccess.open("res://ready.txt",FileAccess.WRITE)\n\tf.store_string("ready")\nfunc save_progress() -> void:\n\tvar f=FileAccess.open("res://saved.txt",FileAccess.WRITE)\n\tf.store_string("saved before closing")\n')
	file.close()
	file=FileAccess.open(tool.game_root+"/main.tscn",FileAccess.WRITE)
	file.store_string('[gd_scene load_steps=2 format=3]\n[ext_resource type="Script" path="res://main.gd" id="1"]\n[node name="Game" type="Node"]\nscript=ExtResource("1")\n')
	file.close()
	var runner=tool.prepare_runner()
	assert(not runner.is_empty())
	tool.game_pid=OS.create_process(OS.get_executable_path(),["--headless","--audio-driver","Dummy","--path",tool.game_root,"--script",runner,"--","--atelier-stop="+tool.stop_file])
	assert(tool.game_pid>0)
	var deadline=Time.get_ticks_msec()+5000
	while not FileAccess.file_exists(tool.game_root+"/ready.txt") and Time.get_ticks_msec()<deadline: await process_frame
	assert(FileAccess.file_exists(tool.game_root+"/ready.txt"))
	tool.staged["main.gd"]="pending"
	await tool.restart_game()
	assert(OS.is_process_running(tool.game_pid) and tool.launches==0)
	tool.staged.clear()
	await tool.restart_game()
	assert(tool.launches==1)
	assert(FileAccess.get_file_as_string(tool.game_root+"/saved.txt")=="saved before closing")
	assert(tool.game_pid==-1)
	await tool.restart_game()
	assert(tool.launches==2,"Restart with no open game must launch one")
	tool.queue_free()
	await process_frame
	print("RESTART PASS: actual child closes after saving, pending edits blocked, restart dispatches new launch")
	quit()
